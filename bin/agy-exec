#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
agy-exec --model <haiku|sonnet|opus|luna|terra|sol> --task <text> [options]

Options:
  --cwd <path>                 Repository/project directory (default: pwd)
  --role <text>                Worker role label
  --mode <inspect|edit>        inspect = do not change files; edit = may change files
  --isolation <worktree|shared> Default: worktree for Git repos, otherwise shared
  --output <path>              Save worker text to a file
  --keep-worktree              Keep temporary worktree for inspection
  -h, --help

Examples:
  agy-exec --model haiku --mode inspect --task "Find auth entry points"
  agy-exec --model sonnet --mode edit --task "Implement the approved auth change"
  agy-exec --model sol --mode inspect --task "Review this architecture for race conditions"
USAGE
}

MODEL_KEY=""
TASK=""
CWD="$(pwd)"
ROLE="worker"
MODE="inspect"
ISOLATION=""
OUTPUT=""
KEEP_WORKTREE=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --model) MODEL_KEY="$2"; shift 2 ;;
    --task) TASK="$2"; shift 2 ;;
    --cwd) CWD="$2"; shift 2 ;;
    --role) ROLE="$2"; shift 2 ;;
    --mode) MODE="$2"; shift 2 ;;
    --isolation) ISOLATION="$2"; shift 2 ;;
    --output) OUTPUT="$2"; shift 2 ;;
    --keep-worktree) KEEP_WORKTREE=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

[[ -n "$MODEL_KEY" && -n "$TASK" ]] || { usage >&2; exit 2; }
[[ "$MODE" == "inspect" || "$MODE" == "edit" ]] || { echo "Invalid --mode" >&2; exit 2; }
CWD="$(cd "$CWD" && pwd)"

CONFIG="${AGY_ORCH_MODELS_FILE:-$HOME/.config/agy-orchestrator/models.env}"
if [[ -f "$CONFIG" ]]; then
  # shellcheck disable=SC1090
  source "$CONFIG"
fi

: "${CLAUDE_HAIKU_MODEL:=claude-haiku-4-5}"
: "${CLAUDE_SONNET_MODEL:=claude-sonnet-5}"
: "${CLAUDE_OPUS_MODEL:=claude-opus-5}"
: "${OPENAI_LUNA_MODEL:=gpt-5.6-luna}"
: "${OPENAI_TERRA_MODEL:=gpt-5.6-terra}"
: "${OPENAI_SOL_MODEL:=gpt-5.6-sol}"
: "${CLAUDE_BUDGET_CHEAP:=0.50}"
: "${CLAUDE_BUDGET_PRIMARY:=2.00}"
: "${CLAUDE_BUDGET_EXPERT:=5.00}"

# Turn budgets are tiered by mode: an inspect worker reads and reports, while an edit
# worker also has to change files, run clippy/tests and react to what they say. A single
# shared cap starves the edit path long before the work is done.
: "${CLAUDE_MAX_TURNS_INSPECT:=20}"
: "${CLAUDE_MAX_TURNS_EDIT:=60}"
if [[ -n "${CLAUDE_MAX_TURNS:-}" ]]; then
  echo "note: CLAUDE_MAX_TURNS is legacy and ignored; set CLAUDE_MAX_TURNS_INSPECT / CLAUDE_MAX_TURNS_EDIT in $CONFIG" >&2
fi

case "$MODEL_KEY" in
  haiku)  PROVIDER=claude; MODEL="$CLAUDE_HAIKU_MODEL"; BUDGET="$CLAUDE_BUDGET_CHEAP" ;;
  sonnet) PROVIDER=claude; MODEL="$CLAUDE_SONNET_MODEL"; BUDGET="$CLAUDE_BUDGET_PRIMARY" ;;
  opus)   PROVIDER=claude; MODEL="$CLAUDE_OPUS_MODEL"; BUDGET="$CLAUDE_BUDGET_EXPERT" ;;
  luna)   PROVIDER=codex;  MODEL="$OPENAI_LUNA_MODEL" ;;
  terra)  PROVIDER=codex;  MODEL="$OPENAI_TERRA_MODEL" ;;
  sol)    PROVIDER=codex;  MODEL="$OPENAI_SOL_MODEL" ;;
  *) echo "Unknown model key: $MODEL_KEY" >&2; exit 2 ;;
esac

if [[ -z "$ISOLATION" ]]; then
  if git -C "$CWD" rev-parse --is-inside-work-tree >/dev/null 2>&1; then ISOLATION=worktree; else ISOLATION=shared; fi
fi

WORKDIR="$CWD"
WT_DIR=""
cleanup() {
  if [[ -n "$WT_DIR" && "$KEEP_WORKTREE" -eq 0 ]]; then
    git -C "$CWD" worktree remove --force "$WT_DIR" >/dev/null 2>&1 || true
    rm -rf "$WT_DIR" >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT

if [[ "$ISOLATION" == "worktree" ]]; then
  git -C "$CWD" rev-parse --is-inside-work-tree >/dev/null 2>&1 || { echo "worktree isolation requires a Git repository" >&2; exit 2; }
  WT_DIR="$(mktemp -d "${TMPDIR:-/tmp}/agy-worker.XXXXXX")"
  # Use detached worktree so concurrent workers do not contend on a branch.
  git -C "$CWD" worktree add --detach "$WT_DIR" HEAD >/dev/null
  WORKDIR="$WT_DIR"
elif [[ "$ISOLATION" != "shared" ]]; then
  echo "Invalid --isolation" >&2; exit 2
fi

if [[ "$MODE" == "inspect" ]]; then
  ACTION_RULE="READ-ONLY TASK. Do not modify, create, delete, rename, commit, or format files. Inspect and report only."
  MAX_TURNS="$CLAUDE_MAX_TURNS_INSPECT"
else
  ACTION_RULE="EDIT TASK. You may edit files required for the task. Do not commit. Keep changes tightly scoped and run the smallest relevant verification."
  MAX_TURNS="$CLAUDE_MAX_TURNS_EDIT"
fi

PROMPT=$(cat <<PROMPT_EOF
You are a delegated software-engineering worker called by an orchestration agent.
Role: $ROLE
Model route: $MODEL_KEY
Working directory: $WORKDIR

$ACTION_RULE

Task:
$TASK

Return a concise structured report with:
1. Outcome
2. Files inspected/changed
3. Verification performed and result
4. Risks or unresolved issues
5. Recommended next action for the orchestrator
Do not delegate to additional agents unless the task explicitly requests it.
PROMPT_EOF
)

TMP_OUT="$(mktemp "${TMPDIR:-/tmp}/agy-output.XXXXXX")"

echo "========================================================"
echo "🚀 [agy-worker] Starting: $ROLE"
echo "   Model:      $MODEL_KEY ($MODEL) via $PROVIDER"
echo "   Mode:       $MODE"
echo "   Isolation:  $ISOLATION"
[[ "$PROVIDER" == "claude" ]] && echo "   Max turns:  $MAX_TURNS (mode=$MODE)"
echo "   Workdir:    $WORKDIR"
echo "========================================================"

# stdin is closed for the worker CLIs: both 'claude -p' and 'codex exec' otherwise
# block reading additional input when launched from a non-interactive dispatcher.
WORKER_EXIT=0
set +e
if [[ "$PROVIDER" == "claude" ]]; then
  command -v claude >/dev/null 2>&1 || { echo "Claude Code CLI 'claude' not found" >&2; exit 127; }
  (
    cd "$WORKDIR"
    claude -p --model "$MODEL" --max-turns "$MAX_TURNS" --max-budget-usd "$BUDGET" \
      --permission-mode acceptEdits --output-format text "$PROMPT" < /dev/null
  ) | tee "$TMP_OUT"
  WORKER_EXIT=${PIPESTATUS[0]}
else
  command -v codex >/dev/null 2>&1 || { echo "Codex CLI 'codex' not found" >&2; exit 127; }
  # workspace-write is deliberately used in isolated worktrees. This avoids current
  # GPT-5.6 read-only tool-provisioning regressions while containing file changes.
  (
    cd "$WORKDIR"
    codex exec --ephemeral -m "$MODEL" --sandbox workspace-write -C "$WORKDIR" "$PROMPT" < /dev/null
  ) | tee "$TMP_OUT"
  WORKER_EXIT=${PIPESTATUS[0]}
fi
set -e

echo
echo "========================================================"
echo "✅ [agy-worker] Finished: $ROLE ($MODEL_KEY)"
echo "========================================================"

if [[ "$WORKER_EXIT" -ne 0 ]] && grep -q "Reached max turns" "$TMP_OUT" 2>/dev/null; then
  echo "hint: worker hit the ${MAX_TURNS}-turn cap for mode=$MODE." >&2
  echo "      Raise CLAUDE_MAX_TURNS_$(echo "$MODE" | tr '[:lower:]' '[:upper:]') in $CONFIG, or split the task." >&2
fi

if git -C "$WORKDIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo
  echo "===== AGY_WORKER_GIT_DIFF ====="
  git -C "$WORKDIR" status --short || true
  git -C "$WORKDIR" diff --no-ext-diff --binary || true
  echo "===== END_AGY_WORKER_GIT_DIFF ====="
fi

if [[ -n "$OUTPUT" ]]; then
  mkdir -p "$(dirname "$OUTPUT")"
  cp "$TMP_OUT" "$OUTPUT"
fi

if [[ -n "$WT_DIR" && "$KEEP_WORKTREE" -eq 1 ]]; then
  echo "AGY_WORKTREE=$WT_DIR"
fi
rm -f "$TMP_OUT"

# Final sentinel. It is always the last line of output, so a dispatcher can poll the
# log and know the report is complete only once this line appears. Anything read
# before it is a partial run and must not be reported as a worker result.
echo "===== AGY_WORKER_END exit=$WORKER_EXIT ====="
exit "$WORKER_EXIT"
