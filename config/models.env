# Agy Orchestrator model mapping
# Change only these values when providers rename or retire models.
CLAUDE_HAIKU_MODEL=claude-haiku-4-5
CLAUDE_SONNET_MODEL=claude-sonnet-5
CLAUDE_OPUS_MODEL=claude-opus-5
OPENAI_LUNA_MODEL=gpt-5.6-luna
OPENAI_TERRA_MODEL=gpt-5.6-terra
OPENAI_SOL_MODEL=gpt-5.6-sol

# Per-call cost guardrails for Claude Code print mode (USD)
CLAUDE_BUDGET_CHEAP=0.50
CLAUDE_BUDGET_PRIMARY=2.00
CLAUDE_BUDGET_EXPERT=5.00

# Cumulative ceiling for one unit of work, across every call sharing a --task-id.
# A per-call cap alone is not cost control: one goal that escalates through five routes
# spends five times the "limit". agy-exec caps each call at the remaining balance and
# refuses to start once the task budget is gone (exit 3). Claude routes only — the Codex
# CLI does not report USD, so those runs record tokens and are not counted here.
AGY_TASK_BUDGET_USD=10.00

# Default worker limits.
# Turn budgets are tiered by mode: inspect only reads and reports, while edit also has to
# change files, run clippy/tests and react to the results. Raise EDIT if workers keep
# failing with "Reached max turns". (The old single CLAUDE_MAX_TURNS is ignored.)
CLAUDE_MAX_TURNS_INSPECT=20
CLAUDE_MAX_TURNS_EDIT=60
